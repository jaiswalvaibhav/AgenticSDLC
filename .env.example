# Copy to .env (gitignored). Any config.yaml key can be overridden as SDLC__SECTION__KEY.
SDLC__ATLASSIAN__BASE_URL=https://your-domain.atlassian.net
SDLC__ATLASSIAN__EMAIL=you@example.com
SDLC__ATLASSIAN__API_TOKEN=your-atlassian-api-token
SDLC__CONFLUENCE__SPACE_KEY=SPACE_KEY
SDLC__JIRA__PROJECT_KEY=PROJECT_KEY

# Profile: local (state in .state/) | aws (state in S3, agent on AgentCore)
SDLC__PROFILE=local

# AWS (standard credential chain; both profiles use Bedrock + the Knowledge Base)
AWS_PROFILE=your-aws-profile
SDLC__AWS__REGION=ap-southeast-2
SDLC__AWS__BUCKET=your-sdlc-bucket

# Local-only stopgap: if set, the analyst agent calls the Anthropic API directly
# instead of Bedrock (profile: local only — ignored by the aws profile/Lambda).
# Billed to this key, not AWS; you'll be asked to confirm each call. Remove once
# Bedrock Claude model access is granted on the AWS account (see CLAUDE.md).
# ANTHROPIC_API_KEY=sk-ant-your-api-key
# ANTHROPIC_MODEL_ID=claude-sonnet-5
